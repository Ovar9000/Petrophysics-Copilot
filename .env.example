# ==============================================================================
# Petrophysical Copilot Environment Configuration
# ==============================================================================

# Google Gemini API Key (Required for LLM Agent & Function Calling)
# Obtain from: https://aistudio.google.com/
GEMINI_API_KEY=your_gemini_api_key_here

# Gemini Model Selection (first model tried; the agent falls back to
# gemini-3.5-flash-lite, then gemini-3.5-flash)
GEMINI_MODEL=gemini-3.5-flash-lite


# Data Directory (Path to folder containing .las files and geology reports)
DATA_DIR=data

# Backend Service Configuration
BACKEND_HOST=127.0.0.1
BACKEND_PORT=8000

# Frontend Service Configuration
FRONTEND_PORT=3000
