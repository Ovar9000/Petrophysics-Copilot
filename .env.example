# ==============================================================================
# Petrophysical Copilot Environment Configuration
# ==============================================================================

# Google Gemini API Key (Required for LLM Agent & Function Calling)
# Obtain from: https://aistudio.google.com/
GEMINI_API_KEY=your_gemini_api_key_here

# Gemini Model Selection (e.g., gemini-2.5-flash, gemini-3.5-flash-lite)
GEMINI_MODEL=gemini-2.5-flash


# Data Directory (Path to folder containing .las files and geology reports)
DATA_DIR=data

# Backend Service Configuration
BACKEND_HOST=127.0.0.1
BACKEND_PORT=8000

# Frontend Service Configuration
FRONTEND_PORT=3000
